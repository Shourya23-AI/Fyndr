# Copy these into your host's environment variables (never commit real values).
NODE_ENV=production
# phone.email Client ID (admin.phone.email > Profile Details). Not secret, but keep it in one place.
PHONE_EMAIL_CLIENT_ID=
# Extra admin emails (comma separated). admin.fyndr@gmail.com is always an admin.
ADMIN_EMAILS=
# Folder for the database + uploaded files. Point it at a PERSISTENT disk/volume.
DATA_DIR=/data
# Set to 1 only if you want the demo "Linear" listings on a live site (off by default in production).
SEED_DEMO=0
